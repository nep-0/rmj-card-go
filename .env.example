# HTTP server
PORT=3000
HOST=0.0.0.0
DISABLE_SVG=false
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20your-token

# Persistent QQ to player-name cache
QQ_NAME_CACHE_FILE=data/qq-name-cache.json

# QQ official bot
QQ_BOT_ENABLED=false
QQ_BOT_APPID=
QQ_BOT_SECRET=
QQ_BOT_PUBLIC_BASE_URL=https://your-public-domain.example.com
QQ_BOT_STYLE=modern
QQ_BOT_COMMAND_PREFIX=/
QQ_BOT_MATCH_REPORTS_FILE=data/qq-match-reports.json
QQ_BOT_MATCH_REPORT_INTERVAL_MS=30000

# QQ official command panel and PNG cache
QQ_BOT_PANEL_GROUPS_FILE=data/qq-panel-groups.json
QQ_BOT_PANEL_ENABLED=true
QQ_BOT_CARD_CACHE_MAX_ENTRIES=512
QQ_BOT_CARD_CACHE_MAX_BYTES=67108864
